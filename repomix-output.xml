// bench_mintas.cpp
// Benchmark : insert / pop / top / deleteKey sur min heap (vector)
// Compilation : g++ -std=c++17 -O2 -Wall -Wextra -o bench_mintas bench_mintas.cpp

#include <iostream>
#include <vector>
#include <random>
#include <chrono>
#include <iomanip>
#include <algorithm>
#include <string>

// ---------- MinHeap minimal (même logique que minTas.cpp) ----------
template <typename T>
class MinHeap {
    std::vector<T> arr;
    void heapify(int i) {
        int n = (int)arr.size();
        int l = 2*i+1, r = 2*i+2, smallest = i;
        if (l < n && arr[l] < arr[smallest]) smallest = l;
        if (r < n && arr[r] < arr[smallest]) smallest = r;
        if (smallest != i) { std::swap(arr[i], arr[smallest]); heapify(smallest); }
    }
public:
    void reserve(std::size_t n) { arr.reserve(n); }
    void insert(const T& v) {
        arr.push_back(v);
        int i = (int)arr.size() - 1;
        while (i != 0 && arr[i] < arr[(i-1)/2]) {
            std::swap(arr[i], arr[(i-1)/2]);
            i = (i-1)/2;
        }
    }
    T pop() {
        T root = arr[0];
        arr[0] = arr.back(); arr.pop_back();
        if (!arr.empty()) heapify(0);
        return root;
    }
    const T& top() const { return arr[0]; }
    int size() const { return (int)arr.size(); }
    bool empty() const { return arr.empty(); }
    bool deleteKey(const T& k) {
        int n = (int)arr.size(), idx = -1;
        for (int i = 0; i < n; ++i) if (arr[i] == k) { idx = i; break; }
        if (idx == -1) return false;
        if (idx == n-1) { arr.pop_back(); return true; }
        arr[idx] = arr.back(); arr.pop_back();
        int i = idx;
        while (i != 0 && arr[i] < arr[(i-1)/2]) {
            std::swap(arr[i], arr[(i-1)/2]); i = (i-1)/2;
        }
        heapify(i);
        return true;
    }
};

using Clock = std::chrono::high_resolution_clock;
static double ms(Clock::time_point a, Clock::time_point b) {
    return std::chrono::duration<double, std::milli>(b - a).count();
}

int main(int argc, char** argv) {
    std::size_t N = (argc > 1) ? std::stoull(argv[1]) : 1'000'000;

    std::mt19937_64 rng(42);
    std::uniform_int_distribution<int> dist(0, 10'000'000);

    std::vector<int> data(N);
    for (auto& x : data) x = dist(rng);

    std::cout << "=== Benchmark MinHeap (N = " << N << ") ===\n";

